{
  "name": "meeting-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev --local --var APP_MODE:demo",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test": "node --experimental-strip-types --test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
